# Application settings
PORT=3000

# Crawler: comma-separated targeted queries and Asia/Taipei cron expressions
CRAWL_KEYWORDS=新北市長,新北選舉,新北市議員 選舉,李四川 新北,蘇巧慧 新北,吳亞倫 新北
CRAWL_CRON=0 */3 * * *
REPORT_CRON=30 8 * * *
SCRAPE_MAX_ARTICLES=12
SCRAPE_RECENT_DAYS=3
SCRAPE_DELAY_MS=500
SCRAPE_CONCURRENCY=4

# Gemini API Key (Required for AI features)
# Get a free key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Email SMTP Settings (For daily PDF summary emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
EMAIL_TO=recipient_email@gmail.com
